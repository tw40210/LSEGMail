# PostgreSQL
POSTGRES_DB=rotationdb
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword

# Gmail OAuth2 (get from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud (path /api/gmail/callback).
# docker-compose.dev.yml maps the app to http://localhost (not :5173) unless you override.
GMAIL_REDIRECT_URI=http://localhost/api/gmail/callback

# Session
SESSION_SECRET=random_string

# Frontend
VITE_API_BASE_URL=/api

# true/1 = show dev UI (Gmail tab, rotation Test Mail); false/empty = hide them
DEV_MODE=
